      "link": null,
      "locked": false,
      "text": "Gate-Service: Receives the capture, owns consent and gallery rules, searches\ncandidates, decides BOARD or MANUAL, records the event, and marks a\npassenger boarded at most once.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gate-Service: Receives the capture, owns consent and gallery rules, searches candidates, decides BOARD or MANUAL, records the event, and marks a passenger boarded at most once.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

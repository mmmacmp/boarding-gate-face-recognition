    {
      "id": "nMtrBr6d53ZHrxxG_e43S",
      "type": "text",
      "x": 117.06928966300552,
      "y": 2014.33621247785,
      "width": 800,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",

    {
      "id": "dsXTWcoK0u-c7I0v-dDmX",
      "type": "text",
      "x": -1941.8712485066114,
      "y": 164.13381921300208,
      "width": 726.6174411139307,
      "height": 311.9985969454037,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 895030899,
      "version": 191,
      "versionNonce": 854596349,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790864230043,
      "created": 1790864209204,
      "link": null,
      "locked": false,
      "text": "circuit breaking numbers:\n- Identity provider timeout: 300 ms\n- Model service timeout: 800 ms\n- Breaker evaluates after at least 5 calls\n- Opens at 50% failures or slow calls\n- Remains open for 10 seconds\n- Allows 2 half-open trial calls",
      "fontSize": 35.65698250804614,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "circuit breaking numbers:\n- Identity provider timeout: 300 ms\n- Model service timeout: 800 ms\n- Breaker evaluates after at least 5 calls\n- Opens at 50% failures or slow calls\n- Remains open for 10 seconds\n- Allows 2 half-open trial calls",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gnARdmaItU1EsEj2YBgfY",
      "type": "text",
      "x": -652.1948013998801,
      "y": 1290.829176850201,
      "width": 164.83959709773293,
      "height": 72.6379552250796,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#e9ecef",
      "fillStyle": "solid",
